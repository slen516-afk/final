erDiagram
    %% ========================================
    %% Relationships
    %% ========================================
    USER ||--|| USER_PROFILE : has
    USER ||--o{ CAREER_SURVEY : completes
    USER ||--o{ RESUME : creates
    USER ||--o{ UPLOAD_EVENT : triggers
    USER ||--o{ APPLICATION_RECORD : submits
    USER ||--o{ USER_SKILL : has
    USER ||--o{ CAREER_ANALYSIS_REPORT : has
    USER ||--o{ RESUME_ANALYSIS : requests
    USER ||--o{ RESUME_OPTIMIZATION : requests
    USER ||--o{ COVER_LETTER : creates
    USER ||--o{ AGENT_SESSION : triggers

    CAREER_SURVEY ||--o{ RESUME : guides
    CAREER_SURVEY ||--o{ CAREER_ANALYSIS_REPORT : generates

    RESUME ||--o{ RESUME_VERSION : has
    RESUME ||--o{ JOB_MATCHING : participates_in
    RESUME ||--o{ CAREER_ANALYSIS_REPORT : analyzes
    RESUME ||--o| OCR_RESULT : parsed_by
    RESUME ||--o{ RESUME_ANALYSIS : analyzed_by
    RESUME ||--o{ RESUME_OPTIMIZATION : optimized_to
    RESUME ||--o{ COVER_LETTER : used_for

    RESUME_OPTIMIZATION ||--o{ COVER_LETTER : used_for_optimized

    RESUME_VERSION ||--o{ APPLICATION_RECORD : used_in
    RESUME_VERSION ||--o{ RESUME_OPTIMIZATION : linked_to

    RESUME_ANALYSIS ||--o| AGENT_SESSION : generated_by

    RESUME_OPTIMIZATION ||--o| AGENT_SESSION : generated_by

    UPLOAD_EVENT ||--|| OCR_RESULT : produces

    COMPANY_INFO ||--o{ JOB_POSTING : owns
    JOB_POSTING ||--o{ APPLICATION_RECORD : receives
    JOB_POSTING ||--o{ JOB_MATCHING : matches_with
    JOB_POSTING ||--o{ JOB_SKILL_REQUIREMENT : requires
    JOB_POSTING ||--o{ RESUME_ANALYSIS : analyzed_for
    JOB_POSTING ||--o{ COVER_LETTER : receives_cover_letter

    JOB_MATCHING ||--|| MATCH_SCORE : has

    SKILL_MASTER ||--o{ JOB_SKILL_REQUIREMENT : defines
    SKILL_MASTER ||--o{ USER_SKILL : defines
    SKILL_MASTER ||--o{ COURSE : "primary_skill"

    CAREER_ANALYSIS_REPORT ||--o{ SIDE_PROJECT_RECOMMENDATION : suggests
    CAREER_ANALYSIS_REPORT ||--o| AGENT_SESSION : generated_by

    AGENT_SESSION ||--o{ COVER_LETTER : generates

    %% ========================================
    %% Tables
    %% ========================================
    USER {
        int user_id PK
        uuid auth_uid UK "UNIQUE, NOT NULL, Supabase auth.users.id"
        string email UK "VARCHAR(255)"
        string password_hash "VARCHAR(255)"
        string auth_provider "VARCHAR(50)"
        datetime created_at
        datetime last_login
        boolean is_active
        int optimization_quota_per_month "每月履歷優化次數上限；0=不開放；DEFAULT 5"
    }

    USER_PROFILE {
        int profile_id PK
        int user_id FK "UNIQUE"
        string github_repo "VARCHAR(100)"
        string full_name "VARCHAR(100)"
        string avatar_url "VARCHAR(500)"
        string location "VARCHAR(100)"
        int years_of_experience
        string current_position "VARCHAR(100)"
        text education_background
        jsonb privacy_settings
        datetime updated_at
    }

    CAREER_SURVEY {
        int survey_id PK
        int user_id FK
        jsonb career_preference
        jsonb skill_self_assessment
        int salary_min
        int salary_max
        string location_preference "VARCHAR(100)"
        string remote_preference "VARCHAR(50)"
        jsonb career_motivation
        jsonb questionnaire_response "完整問卷 module_a/b/c/d；GIN idx_survey_response_gin"
        datetime completed_at
        datetime updated_at
    }

    RESUME {
        int resume_id PK "🔵 履歷生成"
        int user_id FK
        string resume_type "VARCHAR(50)"
        jsonb structured_data "⚡ 需向量化"
        jsonb normalized_data "⚡ 需向量化"
        uuid vector_id "Qdrant Point ID"
        boolean is_embedded "DEFAULT FALSE"
        boolean is_primary
        datetime created_at
        datetime updated_at
    }

    RESUME_VERSION {
        int version_id PK "🔵 履歷生成"
        int resume_id FK
        int version_number
        string file_path "VARCHAR(255)"
        jsonb content
        string optimization_target "VARCHAR(100)"
        datetime created_at
    }

    UPLOAD_EVENT {
        int event_id PK "🔵 履歷生成"
        int user_id FK
        string file_name "VARCHAR(255)"
        string file_path "VARCHAR(500)"
        string upload_type "VARCHAR(50)"
        string status "VARCHAR(50)"
        datetime uploaded_at
        jsonb metadata
    }

    OCR_RESULT {
        int ocr_id PK "🔵 履歷生成"
        int event_id FK
        int resume_id FK
        text raw_text
        jsonb extracted_data
        float confidence_score
        boolean is_manual_review_needed "DEFAULT FALSE"
        string ocr_status "VARCHAR(50)"
        datetime processed_at
    }

    COMPANY_INFO {
        int company_id PK "🟢 職缺推薦"
        string company_name "VARCHAR(200)"
        string industry "VARCHAR(100)"
        string company_size "VARCHAR(50)"
        string location "VARCHAR(200)"
        string website "VARCHAR(500)"
        text description
        datetime created_at
    }

    JOB_POSTING {
        int job_id PK "🟢 職缺推薦"
        int company_id FK
        string job_category "VARCHAR(100)"
        text role_type "例如「前端工程師 / 後端工程師 / 全端」等職務大類"
        text role_name "更細緻的職務名稱或角色標籤"
        numeric d1_frontend "D1 前端工程；分數 1~5"
        numeric d2_backend "D2 後端工程；分數 1~5"
        numeric d3_devops "D3 雲端維運；分數 1~5"
        numeric d4_ai_data "D4 AI與數據；分數 1~5"
        numeric d5_quality "D5 品質與架構；分數 1~5"
        numeric d6_soft_skills "D6 軟實力；分數 1~5"
        string job_title "VARCHAR(200)"
        text job_description "⚡ 需向量化"
        text requirements "⚡ 需向量化"
        uuid vector_id "Qdrant Point ID"
        boolean is_embedded "DEFAULT FALSE"
        boolean is_labeled "是否已完成 D1–D6 能力貼標；DEFAULT FALSE"
        int salary_min
        int salary_max
        string full_address "VARCHAR(200)"
        string city "VARCHAR(50)"
        string district "VARCHAR(50)"
        string remote_option "VARCHAR(50)"
        jsonb job_details
        string source_platform "VARCHAR(50)"
        string source_url "VARCHAR(500)"
        date posted_date
        datetime scraped_at
        boolean is_active
    }

    SKILL_MASTER {
        int skill_id PK
        string skill_name UK "VARCHAR(100)"
        string skill_category "VARCHAR(50)"
        jsonb synonyms
        datetime created_at
    }

    COURSE {
        int course_id PK "🟣 課程推薦"
        string course_name "VARCHAR(500) NOT NULL"
        string url UK "VARCHAR(500) UNIQUE"
        string primary_skill_name "VARCHAR(100)"
        int primary_skill_id FK "→ skill_master"
        float rating "NUMERIC(3,2)"
        int review_count
        string level "VARCHAR(50)"
        string course_type "VARCHAR(100)"
        text course_information
        string duration_suggested "VARCHAR(100)"
        jsonb skills "技能陣列"
        string role_type "六大職類 A-F 貼標"
        text role_name "對應職類名稱"
        string source_platform "VARCHAR(50) DEFAULT 'Coursera'"
        datetime created_at "DEFAULT now()"
    }

    JOB_SKILL_REQUIREMENT {
        int requirement_id PK "🟢 職缺推薦"
        int job_id FK
        int skill_id FK
        string importance "VARCHAR(50)"
        int proficiency_level
    }

    USER_SKILL {
        int user_skill_id PK
        int user_id FK
        int skill_id FK
        int proficiency_level
        float years_of_experience
        boolean verified
        datetime created_at
    }

    JOB_MATCHING {
        int matching_id PK "🟢 職缺推薦"
        int resume_id FK
        int job_id FK
        float overall_match_score
        string matching_algorithm "VARCHAR(50)"
        datetime matched_at "NOT NULL"
        boolean user_viewed "DEFAULT FALSE"
        string matching_status "DEFAULT 'active'"
    }

    MATCH_SCORE {
        int score_id PK "🟢 職缺推薦"
        int matching_id FK
        float skill_match_score
        float experience_match_score
        float salary_match_score
        float location_match_score
        jsonb score_breakdown
        datetime created_at
    }

    APPLICATION_RECORD {
        int application_id PK "🟢 職缺推薦"
        int user_id FK
        int job_id FK
        int version_id FK
        string application_status "VARCHAR(50)"
        datetime applied_at
        datetime status_updated_at
        int days_since_application
        jsonb user_feedback
    }

    CAREER_ANALYSIS_REPORT {
        int report_id PK "🟠 職能分析"
        int survey_id FK
        int resume_id FK
        jsonb target_position "LLM分析報告中識別出的目標職位資訊"
        jsonb skill_gap_analysis
        jsonb career_path_suggestions
        jsonb market_insights
        float career_readiness_score
        datetime generated_at "NOT NULL"
        int user_id FK "直接關聯用戶"
        string report_version "VARCHAR(10) DEFAULT '1.0'"
        jsonb preliminary_summary
        jsonb radar_chart
        jsonb gap_analysis
        jsonb action_plan
    }

    SIDE_PROJECT_RECOMMENDATION {
        int recommendation_id PK "🟠 職能分析"
        int report_id FK "→ CAREER_ANALYSIS_REPORT"
        int user_id FK "冗餘，→ USER"
        string project_name "VARCHAR(200)"
        jsonb tech_stack "完整技術棧 List[str]"
        text difficulty "難度等級 | 預估開發週期"
        jsonb capability_gaps_addressed "List[str] 補強的能力缺口"
        jsonb project_phases "List[ProjectPhase] 分階段規劃"
        text overall_resume_impact "對履歷競爭力的提升說明"
        timestamptz created_at "DEFAULT now()"
    }

    RESUME_ANALYSIS {
        bigserial analysis_id PK "🔵 履歷生成"
        int resume_id FK "NOT NULL"
        int user_id FK "NOT NULL"
        int target_job_id FK "可選"
        text candidate_positioning "企業視角下此履歷代表的角色定位"
        text target_role_gap_summary "與目標職位的整體落差說明"
        jsonb overall_strengths "List[str] 最具說服力的優勢點"
        jsonb overall_weaknesses "List[str] 影響錄取率的核心弱點"
        string ats_risk_level "VARCHAR(20) low/medium/high"
        text screening_outcome_prediction "模擬 6-10 秒掃描後的篩選結果"
        jsonb recommended_next_actions "List[str] 可執行的下一步建議"
        jsonb critical_issues "List[ResumeIssue] 履歷各區塊問題條目，含 section/original_text/issue_type/severity/diagnosis_dimension/issue_reason/improvement_direction"
        string llm_model_used "VARCHAR(100)"
        string analysis_version "VARCHAR(10) DEFAULT '1.0'"
        timestamptz generated_at "NOT NULL, DEFAULT NOW()"
    }

    RESUME_OPTIMIZATION {
        bigserial optimization_id PK "🔵 履歷生成"
        int resume_id FK "NOT NULL"
        int version_id FK "可選"
        int user_id FK "NOT NULL"
        text professional_summary "優化後的專業摘要"
        jsonb professional_experience "List[dict] 優化後的工作經歷（含 STAR 原則）"
        jsonb core_skills "List[str] 萃取的核心技能關鍵字"
        jsonb projects "List[dict] 優化後的專案描述"
        jsonb education "List[str] 最高學歷資訊"
        text autobiography "保留原風格的優化後完整自傳"
        string llm_model_used "VARCHAR(100)"
        string optimization_version "VARCHAR(10) DEFAULT '1.0'"
        jsonb template_color "履歷樣板與配色；含 template_key/name、color_scheme，見說明文件"
        uuid vector_id "Qdrant Point ID，optimized_resume_vectors 回填用"
        boolean is_embedded "DEFAULT FALSE，是否已寫入 Qdrant"
        timestamptz created_at "NOT NULL, DEFAULT NOW()"
    }

    COVER_LETTER {
        bigserial cover_letter_id PK "🟢 職缺推薦"
        int user_id FK "NOT NULL"
        int job_id FK "NOT NULL"
        int resume_id FK "可選"
        bigint optimization_id FK "可選，產生時使用的履歷優化結果"
        bigint agent_session_id FK "可選"
        text subject "NOT NULL 吸引人且專業的郵件主旨"
        text content "NOT NULL 完整求職信正文"
        string llm_model_used "VARCHAR(100)"
        boolean is_sent "DEFAULT FALSE"
        timestamptz sent_at
        timestamptz created_at "NOT NULL, DEFAULT NOW()"
    }

    AGENT_SESSION {
        bigserial session_id PK "⚙️ 系統追蹤"
        int user_id FK "NOT NULL"
        int resume_id FK "可選"
        string trigger_type "VARCHAR(50) job_match/resume_analysis/career_report/full"
        text user_input_summary "使用者輸入的摘要（隱私保護）"
        boolean tool_job_match_called "DEFAULT FALSE"
        boolean tool_resume_analysis_called "DEFAULT FALSE"
        boolean tool_resume_optimize_called "DEFAULT FALSE"
        boolean tool_skill_gap_called "DEFAULT FALSE"
        boolean tool_side_project_called "DEFAULT FALSE"
        boolean tool_course_recommend_called "DEFAULT FALSE"
        boolean tool_cover_letter_called "DEFAULT FALSE"
        bigint analysis_id FK "可選"
        bigint optimization_id FK "可選"
        int career_report_id FK "可選"
        jsonb recommended_job_ids "List[int] 推薦的 job_id"
        jsonb recommended_course_ids "List[int] 推薦的 course_id"
        int total_tokens_used "消耗 Token 數"
        int latency_ms "回應時間（毫秒）"
        string llm_model_used "VARCHAR(100)"
        string status "VARCHAR(50) running/completed/failed DEFAULT 'completed'"
        text error_message "失敗時的錯誤原因"
        timestamptz created_at "NOT NULL, DEFAULT NOW()"
        timestamptz completed_at
    }

