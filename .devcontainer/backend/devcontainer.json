{
    "name": "Backend (Python)",
    "dockerComposeFile": "../../docker-compose.yml",
    "service": "backend",
    "workspaceFolder": "/app",
    "mounts": [
        "source=${localWorkspaceFolder}/.hf_cache,target=/root/.cache/huggingface,type=bind"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python"
            ]
        }
    }
}